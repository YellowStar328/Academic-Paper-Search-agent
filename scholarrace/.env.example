# ============ Application ============
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ============ Database ============
DATABASE_URL=postgresql+asyncpg://scholar:scholar@localhost:5432/scholarrace
# For tests (auto-used when APP_ENV=test)
DATABASE_URL_TEST=sqlite+aiosqlite:///./test.db

# ============ Redis ============
REDIS_URL=redis://localhost:6379/0

# ============ LLM Providers (OpenAI-compatible) ============
# Qwen (DashScope compatible)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# GLM (Zhipu)
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-plus

# Strong Judge (use a separate strong model)
STRONG_MODEL_API_KEY=
STRONG_MODEL_BASE_URL=https://api.deepseek.com/v1
STRONG_MODEL_NAME=deepseek-reasoner

# ============ Search Sources ============
ARXIV_BASE_URL=http://export.arxiv.org/api/query
ARXIV_MAX_RESULTS=50
ARXIV_TIMEOUT=30

# ============ Embedding ============
EMBEDDING_TOP_K=100
EMBEDDING_DIM=256
# Set to "fake" for deterministic hash encoder, "api" for OpenAI-compatible
EMBEDDING_BACKEND=fake

# ============ Ranking Weights ============
W_RELEVANCE=0.35
W_AUTHORITY=0.15
W_RECENCY=0.15
W_CITATION=0.15
W_DIVERSITY=0.15
W_REDUNDANCY=0.05
MMR_LAMBDA=0.7
FINAL_TOP_K=20

# ============ Thompson Sampling ============
THOMPSON_EXPLORATION_FLOOR=0.10
THOMPSON_BATCH_SIZE=16
THOMPSON_INITIAL_ALPHA=1.0
THOMPSON_INITIAL_BETA=1.0

# ============ Citation Expansion ============
CITATION_EXPANSION_DEPTH=1
CITATION_EXPANSION_TOP_N=10

# ============ Retrieval ============
RETRIEVAL_MAX_RESULTS_PER_SOURCE=50
